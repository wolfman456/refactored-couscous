# Railway container DNS (see /etc/resolv.conf). Re-resolve the upstream hostname
# on each backend redeploy instead of caching it once at startup.
resolver [fd12::10]:53 valid=5s ipv6=on;

server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 25m;

  set $api_host ${API_HOST};
  set $api_port ${API_PORT};

  location /api/ {
    proxy_pass http://$api_host:$api_port;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /uploads/ {
    proxy_pass http://$api_host:$api_port;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ~ ^/(gallery/[0-9]+|articles/[a-z0-9-]+)/?$ {
    set $metadata_route /$1;
    ssi on;
    add_header Cache-Control "no-cache";
    rewrite ^ /index.html break;
  }

  location ~ ^/_piece-meta(?<metadata_path>/.*)$ {
    internal;
    proxy_pass http://$api_host:$api_port/api/page-meta$metadata_path;
    proxy_set_header Accept-Encoding "";
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @metadata_unavailable;
  }

  location @metadata_unavailable {
    return 204;
  }

  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  location ~* ^/assets/.*\.(css|js)$ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}